{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "npm i --no-save --legacy-peer-deps @firebase/rules-unit-testing && firebase emulators:exec --only firestore --project swm-rules-test \"node tests/rules/firestore.rules.test.mjs\"",
    "test:integration": "firebase emulators:exec --only firestore,auth --project swm-dispatch-test \"node tests/integration/dispatch.integration.test.mjs\"",
    "dispatch:worker": "node scripts/dispatchWorker.mjs",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project swm-dispatch-e2e \"node tests/integration/dispatch.e2e.test.mjs\"",
    "test:security": "npm i --no-save --legacy-peer-deps @firebase/rules-unit-testing && firebase emulators:exec --only firestore --project swm-security-test \"node tests/rules/security.rules.test.mjs\"",
    "test:admin": "firebase emulators:exec --only firestore,auth --project swm-admin-test \"node tests/integration/admin.users.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.3"
  }
}
