rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// Smart Waste MIS — Firestore security rules (versioned in-repo).
//
// NOT DEPLOYED AUTOMATICALLY. Deploy explicitly with:
//   firebase deploy --only firestore:rules
// after the security suite passes (npm run test:security) and with the owner's approval.
//
// Model (docs/security/SECURITY_FIX_PLAN.md):
//   - FAIL CLOSED. A profile users/{uid} with status "active" and a KNOWN role is required.
//     executive (Amanah decision maker) is the only city-wide role. manager / employee / driver
//     get operational access ONLY with a non-empty municipalityId, and only inside it.
//     Unknown roles, missing roles, missing municipality → no operational access.
//   - Role / status / municipality of a user are NEVER written by a client (not even the Amanah):
//     they change through the trusted server route /api/admin/users (firebase-admin).
//   - Audit entries carry the real actor (actorId == auth uid); system actors are server-only;
//     entries are immutable.
//   - Every list query from a scoped account must filter on municipalityId (or driverId for drivers)
//     so the rules can prove the result set.
// ─────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── identity ──
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return hasProfile() && me().get("status", "") == "active"; }
    function role() { return me().get("role", ""); }
    function myMun() { return me().get("municipalityId", ""); }
    function hasMun() { return myMun() is string && myMun().size() > 0; }

    function isAdmin()    { return active() && role() == "executive"; }                            // Amanah: city-wide
    function isManager()  { return active() && role() == "manager"  && hasMun(); }
    function isOps()      { return active() && role() == "employee" && hasMun(); }
    function isDriver()   { return active() && role() == "driver"   && hasMun(); }
    function isCitizen()  { return active() && role() == "citizen"; }
    function isEmployee() { return isAdmin() || isManager() || isOps(); }                          // back-office staff
    function isStaff()    { return isEmployee() || isDriver(); }

    // A document is in my scope: the Amanah sees everything, scoped staff only their municipality.
    function inMun(data) { return isAdmin() || (hasMun() && data.get("municipalityId", "") == myMun()); }
    // A write keeps the document inside my scope (cannot move it to another municipality).
    function staysInMun() { return inMun(resource.data) && inMun(request.resource.data); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function binInMyMun(binId) { return binId is string && get(/databases/$(database)/documents/bins/$(binId)).data.get("municipalityId", "") == myMun(); }
    function routeDoc(routeId) { return get(/databases/$(database)/documents/collection_routes/$(routeId)).data; }

    // ── users ──
    // Sensitive keys are written by the server route /api/admin/users only.
    function sensitiveUserKeys() { return ["role", "roleAr", "status", "municipalityId", "homeMunicipalityId", "transferId", "transferUntil", "uid"]; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
                    || ((isManager() || isOps()) && resource.data.get("municipalityId", "") == myMun()));
      // Self-registration: citizens are active immediately; staff roles stay "pending" until the server approves them.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ["citizen", "employee", "manager", "executive", "driver"]
                    && request.resource.data.status == (request.resource.data.role == "citizen" ? "active" : "pending")
                    && !request.resource.data.keys().hasAny(["homeMunicipalityId", "transferId", "transferUntil"])
                    && (request.resource.data.role != "citizen" || request.resource.data.get("municipalityId", null) == null);
      allow update: if signedIn() && request.auth.uid == uid && !changed().hasAny(sensitiveUserKeys());
      allow delete: if false;
    }

    match /municipalities/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /neighborhoods/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || ((isManager() || isOps()) && request.resource.data.get("municipalityId", "") == myMun());
      allow delete: if isAdmin() || (isManager() && resource.data.get("municipalityId", "") == myMun());
      // Neighborhood ↔ municipality assignment is an Amanah decision.
      allow update: if isAdmin() || ((isManager() || isOps()) && resource.data.get("municipalityId", "") == myMun()
                    && !changed().hasAny(["municipalityId", "municipalityAssignment", "municipalityHistory"]));
    }

    // ── sensors ──
    match /bins/{id} {
      allow read: if (isStaff() && inMun(resource.data)) || isCitizen();
      allow create: if isEmployee() && inMun(request.resource.data);
      allow delete: if isEmployee() && inMun(resource.data);
      // Collection time is written by the server confirmation route only (/api/field/confirm-collection).
      // Exception: SIMULATED demo bins, whose simulator models the physical emptying.
      allow update: if isEmployee() && staysInMun()
                    && (!changed().hasAny(["lastCollectionAt"]) || resource.data.get("simulated", false) == true);
    }
    // Real readings: append-only, written ONLY by /api/iot/readings (firebase-admin).
    match /sensor_readings/{id} {
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isAdmin() && resource.data.get("demo", false) == true;
    }
    // Simulated readings: labelled demo data, inside the writer's municipality.
    match /simulated_readings/{id} {
      allow read: if isStaff();
      allow create: if isEmployee() && inMun(request.resource.data)
                    && (request.resource.data.get("source", "") == "SIMULATED" || request.resource.data.get("demo", false) == true);
      allow update, delete: if isAdmin();
    }
    // Device registry (holds the key hash): Amanah, or the municipality manager for devices of their municipality.
    match /iot_devices/{id} {
      allow read: if isAdmin() || (isManager() && resource.data.get("municipalityId", "") == myMun());
      allow create: if isAdmin() || (isManager() && request.resource.data.get("municipalityId", "") == myMun() && binInMyMun(request.resource.data.get("binId", "")));
      allow update: if isAdmin() || (isManager() && resource.data.get("municipalityId", "") == myMun()
                    && request.resource.data.get("municipalityId", "") == myMun()
                    && (!changed().hasAny(["binId"]) || binInMyMun(request.resource.data.get("binId", ""))));
      allow delete: if isAdmin();
    }
    match /simulation_state/{id} { allow read: if isStaff(); allow write: if isEmployee(); }
    match /demo_sessions/{id}    { allow read: if isStaff(); allow write: if isEmployee(); }

    // ── Amanah-level entities ──
    match /support_requests/{id} {
      allow read: if isEmployee() && inMun(resource.data);
      allow create: if (isManager() || isOps()) && inMun(request.resource.data) && request.resource.data.status == "open";
      allow update: if isAdmin() || ((isManager() || isOps()) && inMun(resource.data)
                    && changed().hasOnly(["note", "updatedAt", "withdrawnAt", "status"]) && request.resource.data.status in ["open", "withdrawn"]);
      allow delete: if false;
    }
    // The Amanah proposes and decides from the client; EXECUTION and RETURN happen only in /api/admin/transfers
    // (one transaction moving vehicle + driver profile + account + status together).
    match /resource_transfers/{id} {
      allow read: if isAdmin() || ((isManager() || isOps()) && (resource.data.fromMunicipalityId == myMun() || resource.data.toMunicipalityId == myMun()));
      allow create: if isAdmin() && request.resource.data.status == "proposed";
      // APPROVAL reserves the lent resources for the loan window and is server-only (/api/admin/transfers, one transaction
      // with a per-resource lock). The client may only reject a proposal.
      allow update: if isAdmin() && resource.data.status == "proposed" && request.resource.data.status == "rejected"
                    && changed().hasOnly(["status", "decidedBy", "decidedByName", "decidedAt", "decisionNote", "updatedAt"]);
      allow delete: if false;
    }
    // Time-window reservations of drivers / vehicles (loans and approved operational adjustments) — server-written only.
    match /resource_reservations/{id} {
      allow read: if isAdmin() || ((isManager() || isOps()) && myMun() in resource.data.get("municipalityIds", []));
      allow write: if false;
    }
    match /resource_locks/{id} { allow read, write: if false; }
    // Minimum operational adjustment analyses — written ONLY by /api/ops/adjustment (analysis, approval, rejection,
    // outcome). Back-office staff read their municipality's; drivers and citizens never.
    match /adjustment_analyses/{id} {
      allow read: if isEmployee() && inMun(resource.data);
      allow write: if false;
    }
    match /optimization_runs/{id}    { allow read: if isEmployee() && inMun(resource.data); allow create: if isEmployee() && inMun(request.resource.data); allow update, delete: if isAdmin() && resource.data.get("demo", false) == true; }
    match /simulation_scenarios/{id} { allow read: if isEmployee() && inMun(resource.data); allow create: if (isAdmin() || isManager()) && inMun(request.resource.data); allow update, delete: if isAdmin(); }
    match /decision_recommendations/{id} { allow read: if isEmployee() && inMun(resource.data); allow create, update: if isEmployee() && inMun(request.resource.data); allow delete: if false; }

    // ── Autonomous dispatch (written by the server runner via firebase-admin) ──
    match /dispatch_settings/{id} {
      allow read: if isEmployee();
      allow write: if isAdmin() && request.resource.data.mode in ["off", "observe", "auto"] && request.resource.data.scope in ["demo_only", "all"]
                   && validTargets(request.resource.data.get("targets", {})) && validImpactFactors(request.resource.data.get("impactFactors", {}));
    }
    // Operational targets and impact factors are decision inputs: typed, bounded, no extra keys.
    function numIn(m, k, lo, hi) { return !(k in m) || (m[k] is number && m[k] >= lo && m[k] <= hi); }
    function optNumIn(m, k, lo, hi) { return !(k in m) || m[k] == null || (m[k] is number && m[k] >= lo && m[k] <= hi); }
    function validTargets(t) {
      return t == null || (t is map && t.keys().hasOnly(["criticalCollectionMin", "onTimePct", "maxRouteKm", "vehicleUtilizationPct", "maxLateBins"])
        && numIn(t, "criticalCollectionMin", 5, 1440) && numIn(t, "onTimePct", 0, 100) && numIn(t, "maxRouteKm", 1, 500)
        && numIn(t, "vehicleUtilizationPct", 0, 100) && numIn(t, "maxLateBins", 0, 1000));
    }
    function validImpactFactors(f) {
      return f == null || (f is map && f.keys().hasOnly(["fuelLitersPerKm", "co2KgPerLiter", "avgUrbanSpeedKmh"])
        && optNumIn(f, "fuelLitersPerKm", 0, 5) && optNumIn(f, "co2KgPerLiter", 0, 10) && optNumIn(f, "avgUrbanSpeedKmh", 1, 120));
    }
    match /dispatch_decisions/{id} {
      allow read: if isEmployee() && inMun(resource.data);
      allow create, delete: if false;
      allow update: if isEmployee() && inMun(resource.data) && resource.data.status == "open"
                    && request.resource.data.status in ["resolved", "dismissed"]
                    && changed().hasOnly(["status", "resolvedBy", "resolvedByName", "resolvedAt", "resolutionNote", "updatedAt"]);
    }
    match /dispatch_runs/{id}  { allow read: if isEmployee(); allow write: if false; }
    match /dispatch_locks/{id} { allow read, write: if false; }
    match /rate_limits/{id}    { allow read, write: if false; } // server-side rate limiter (Firestore-backed)
    match /driver_notifications/{id} {
      allow read: if (isDriver() && resource.data.driverId == request.auth.uid) || (isEmployee() && inMun(resource.data));
      allow update: if isDriver() && resource.data.driverId == request.auth.uid && changed().hasOnly(["read", "readAt"]);
      allow create, delete: if false;
    }

    // ── fleet ──
    match /vehicles/{id} {
      allow read: if isStaff() && inMun(resource.data);
      allow create: if isEmployee() && inMun(request.resource.data);
      allow update: if (isEmployee() && staysInMun())
                    || (isDriver() && resource.data.driverId == request.auth.uid
                        && changed().hasOnly(["status", "currentRouteId", "lastActiveAt", "updatedAt"]));
      allow delete: if isEmployee() && inMun(resource.data);
    }
    match /route_bins/{id} { allow read, write: if isAdmin(); } // declared, unused
    match /driver_profiles/{uid} {
      allow read: if (isEmployee() && inMun(resource.data)) || (isDriver() && request.auth.uid == uid);
      allow create: if isEmployee() && inMun(request.resource.data);
      allow delete: if isEmployee() && inMun(resource.data);
      allow update: if (isEmployee() && staysInMun())
                    || (isDriver() && request.auth.uid == uid
                        && changed().hasOnly(["shiftStatus", "availability", "locationSharing", "lastLocation", "updatedAt"]));
    }
    match /driver_vehicle_assignments/{id} { allow read: if isStaff() && inMun(resource.data); allow create, update: if isEmployee() && inMun(request.resource.data); allow delete: if false; }
    match /driver_assignment_history/{id}  { allow read: if isEmployee(); allow create: if isEmployee(); allow update, delete: if false; }
    match /driver_shifts/{id} {
      allow read: if isEmployee() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── routes & field execution ──
    match /collection_routes/{id} {
      allow read: if (isEmployee() && inMun(resource.data)) || (isDriver() && resource.data.driverId == request.auth.uid);
      // A new real route carries no collection progress and is not already running/completed (that is server/driver
      // lifecycle). Demo-labelled history routes of the simulation scene are the only exception.
      allow create: if isEmployee() && inMun(request.resource.data)
                    && (request.resource.data.get("demo", false) == true
                        || (request.resource.data.get("collectedBinIds", []).size() == 0 && !(request.resource.data.get("status", "") in ["in_progress", "completed"])));
      allow delete: if isEmployee() && inMun(resource.data);
      // Drivers advance only the execution fields of THEIR route, along the lifecycle approved → in_progress → completed.
      // collectedBinIds is collection data: only the server confirmation route writes it (no client, no role).
      allow update: if (isEmployee() && staysInMun() && !changed().hasAny(["collectedBinIds"]))
                    || (isDriver() && resource.data.driverId == request.auth.uid
                        && resource.data.status in ["approved", "in_progress"]
                        && changed().hasOnly(["status", "startedAt", "completedAt", "skippedStops", "lastProgressAt", "driverName", "liveRoad", "updatedAt"])
                        && (request.resource.data.status == resource.data.status
                            || (resource.data.status == "approved" && request.resource.data.status == "in_progress")
                            || (resource.data.status == "in_progress" && request.resource.data.status == "completed")));
    }
    // Collection confirmations: written ONLY by /api/field/confirm-collection (one transaction, idempotent id
    // routeId__binId, route in progress, bin on the route, vehicle valid). No client may create or edit them.
    match /collection_events/{id} {
      allow read: if isStaff() && inMun(resource.data);
      // Real confirmations are written ONLY by /api/field/confirm-collection. The single client exception is the
      // demo scene's simulated history: back-office staff, own municipality, demo-labelled, on a COMPLETED demo route.
      allow create: if isEmployee() && inMun(request.resource.data)
                    && request.resource.data.get("demo", false) == true && request.resource.data.get("_demoSeedVersion", "") is string
                    && request.resource.data.get("_demoSeedVersion", "") != ""
                    && routeDoc(request.resource.data.routeId).get("demo", false) == true
                    && routeDoc(request.resource.data.routeId).status == "completed";
      allow update: if false;
      allow delete: if isAdmin() && resource.data.get("demo", false) == true;
    }
    match /route_incidents/{id} {
      allow read: if (isEmployee() && inMun(resource.data)) || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if (isEmployee() && inMun(request.resource.data))
                    || (isDriver() && request.resource.data.driverId == request.auth.uid
                        && routeDoc(request.resource.data.routeId).driverId == request.auth.uid);
      allow update: if isEmployee() && staysInMun();
      allow delete: if isAdmin() && resource.data.get("demo", false) == true;
    }
    match /driver_locations/{id} {
      allow read: if isEmployee() && inMun(resource.data);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if false;
    }
    match /vehicle_status_history/{id} {
      allow read: if isEmployee();
      allow create: if (isEmployee() && inMun(request.resource.data))
                    || (isDriver() && request.resource.data.get("actorId", "") == request.auth.uid
                        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.get("driverId", "") == request.auth.uid);
      allow update, delete: if false;
    }

    // ── audit: real actor, own municipality, immutable; system actors are server-only ──
    function reservedActorNames() { return ["الإسناد التلقائي", "النظام", "النظام (مزامنة تلقائية)", "system"]; }
    match /audit_log/{id} {
      allow read: if isAdmin() || ((isManager() || isOps()) && resource.data.get("municipalityId", "") == myMun());
      allow create: if isStaff()
                    && request.resource.data.get("actorId", "") == request.auth.uid
                    && !(request.resource.data.get("actorName", "") in reservedActorNames())
                    && (isAdmin() || request.resource.data.get("municipalityId", "") == myMun());
      allow update: if false;
      allow delete: if isAdmin() && resource.data.get("demo", false) == true; // demo-scene reset only
    }

    // ── alerts & reference data that feeds operational decisions ──
    match /alerts/{id} {
      allow read: if isStaff() && inMun(resource.data);
      allow create: if isEmployee() && inMun(request.resource.data);
      allow update: if isEmployee() && staysInMun();
      allow delete: if isAdmin();
    }
    match /fire_sensors/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /fire_alerts/{id}  { allow read: if isStaff();  allow write: if isAdmin(); }
    match /analytics/{doc}   { allow read: if signedIn(); allow write: if isAdmin(); }

    // ── citizens ──
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || (isEmployee() && inMun(resource.data)));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isEmployee() && staysInMun();
      allow delete: if isEmployee() && inMun(resource.data);
    }
    match /citizen_reports/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || (isEmployee() && inMun(resource.data)));
      // Citizens file their own reports; staff may only create rows flagged demo:true (seeded demo scene) in their municipality.
      allow create: if (signedIn() && request.resource.data.userId == request.auth.uid)
                    || (isEmployee() && request.resource.data.get("demo", false) == true && inMun(request.resource.data));
      allow update: if isEmployee() && staysInMun();
      allow delete: if isEmployee() && inMun(resource.data);
    }

    // ── legacy suction-model collections (read-only reference; writes are Amanah-only) ──
    match /stations/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /suctionJobs/{id}  { allow read: if isStaff();  allow write: if false; }
    match /containers/{id}   { allow read: if isStaff();  allow write: if false; }
    match /districts/{id}    { allow read: if isStaff();  allow write: if false; }
    match /sensors/{id}      { allow read: if isStaff();  allow write: if false; }
    match /reports/{id}      { allow read: if isStaff();  allow write: if isAdmin(); }
  }
}
