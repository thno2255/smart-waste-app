# Server-side only (Vercel → Project Settings → Environment Variables).
# NEVER prefix these with VITE_ — that would ship them to the browser bundle.

# Full Firebase service-account JSON on one line (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Kill switch for the ESP32 ingest route (/api/iot/readings). Set to "true" to accept device readings.
IOT_INGEST_ENABLED=false
